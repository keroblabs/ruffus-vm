#
# Platform.config
#

name Platform-Generic
maxsize 60000
class_offset 8192

# info on target
filename output.bin

# load lists of native methods - keep the order!!
native lang_Object
native lang_Class
native lang_System
native lang_Boolean
native lang_Byte
native lang_Character
native lang_Short
native lang_Integer
native lang_Long
native lang_Float
native lang_Double
#native lang_Integer_Array
#native lang_Void

native lang_Math
native lang_String
native lang_StringBuilder
native lang_Process
native lang_Number
native lang_Runtime
native lang_Thread

native lang_Reflect_Field
native lang_Reflect_Method

native util_BitSet
native util_Calendar
native util_Date
#native util_Formatter
native util_StringTokenizer
native util_Random
native util_Timer
native util_TimerTask
native util_TimeZone
native util_Vector

native io_File
native io_FileInputStream
native io_FileOutputStream
native io_InputStream
native io_OutputStream
native io_PrintStream
native io_RandomAccessFile

native ruffus_objects_Disposable
native ruffus_graphics_Drawing
native ruffus_graphics_Colour
native ruffus_system_InputPointer
native ruffus_system_EventArgs
native ruffus_widgets_Widget
native ruffus_widgets_Button
native ruffus_widgets_TextBox
native ruffus_widgets_TextLabel
native ruffus_widgets_Form
native ruffus_widgets_Menu
#native ruffus_widgets_MenuItem

#exceptions
native throw_lang_InterruptedException
native throw_lang_NullPointerException
native throw_lang_NegativeArraySizeException
native throw_lang_ArithmeticException
native throw_lang_ArrayStoreException
native throw_lang_IllegalArgumentException
native throw_lang_NoSuchMethodException
native throw_lang_NoSuchFieldException
native throw_lang_IndexOutOfBoundsException
native throw_lang_ArrayIndexOutOfBoundsException
native throw_lang_StringIndexOutOfBoundsException
native throw_lang_ClassNotFoundException
native throw_lang_UnsupportedOperationException
native throw_util_EmptyStackException
native throw_io_CharConversionException 
native throw_io_EOFException 
native throw_io_FileNotFoundException 
native throw_io_InterruptedIOException 
native throw_io_InvalidClassException 
native throw_io_InvalidObjectException 
native throw_io_IOException 
native throw_io_NotActiveException 
native throw_io_ObjectStreamException 
native throw_io_StreamCorruptedException 
native throw_io_WriteAbortedException

